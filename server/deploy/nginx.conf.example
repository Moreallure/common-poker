# Include in nginx's http context (e.g. /etc/nginx/conf.d/commonpoker.conf).
# Replace poker-api.example.com and provision its TLS certificate before enabling.
limit_req_zone $binary_remote_addr zone=poker_requests:1m rate=1r/s;
limit_req_zone $server_name zone=poker_global_requests:1m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=poker_connections:1m;
limit_conn_zone $server_name zone=poker_global_connections:1m;

server {
    listen 80;
    listen [::]:80;
    server_name poker-api.example.com;
    return 301 https://poker-api.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name poker-api.example.com;
    ssl_certificate /etc/letsencrypt/live/poker-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/poker-api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/commonpoker-error.log error;
    limit_req_log_level warn;
    limit_conn_log_level warn;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=poker_requests burst=8 nodelay;
    limit_req zone=poker_global_requests burst=40 nodelay;
    limit_conn poker_connections 12;
    limit_conn poker_global_connections 64;
    client_header_timeout 10s;
    client_body_timeout 10s;
    client_max_body_size 1k;
    large_client_header_buffers 2 4k;
    keepalive_timeout 15s;
    send_timeout 10s;
    add_header X-Content-Type-Options nosniff always;

    location = /ws {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarding headers; trust only this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 10s;
        proxy_buffering off;
    }

    location ~ ^/(health|rooms)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
    }

    location / { return 404; }
}
